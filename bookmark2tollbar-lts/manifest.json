{
	"manifest_version": 3,
	"version": "1.1.0",
	"name": "Bookmark2Toolbar - 1/3",
	"description": "Add a bookmark to the toolbar",

	"background": {
		"service_worker": "background.js",
		"type": "module"
	},

	"icons": {
		"16": "icons/ico16.png",
		"32": "icons/ico32.png",
		"48": "icons/ico48.png",
		"128": "icons/ico128.png"
	},

	"action": {
		"default_icon": {
			"16": "icons/ico16.png",
			"32": "icons/ico32.png",
			"48": "icons/ico48.png",
			"128": "icons/ico128.png"
		}
	},

	"permissions": ["activeTab", "contextMenus", "storage"],

	"host_permissions": ["https://www.google.com/*", "https://*.gstatic.com/*"]
}
